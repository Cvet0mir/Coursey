@using Coursey.ViewModels.Student
@model StudentDetailsViewModel

@{
    ViewData["Title"] = "Student Details";
}

<div class="container mt-4">

    <h2 class="mb-4">Student Details</h2>

    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                @Model.FirstName @Model.LastName
            </h5>
        </div>

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-4">First Name</dt>
                <dd class="col-sm-8">@Model.FirstName</dd>

                <dt class="col-sm-4">Last Name</dt>
                <dd class="col-sm-8">@Model.LastName</dd>

                <dt class="col-sm-4">Email</dt>
                <dd class="col-sm-8">@Model.Email</dd>

                <dt class="col-sm-4">Birth Date</dt>
                <dd class="col-sm-8">
                    @Model.BirthDate.ToString("dd.MM.yyyy")
                </dd>

                <dt class="col-sm-4">Favourite Subject</dt>
                <dd class="col-sm-8">
                    @(Model.FavouriteSubject ?? "Not specified")
                </dd>

            </dl>

            <hr />

            <h5 class="mb-3">Enrolled Courses</h5>

            @if (Model.Courses.Any())
            {
                <ul class="list-group">
                    @foreach (var course in Model.Courses)
                    {
                        <li class="list-group-item">
                            @course
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted">
                    This student is not enrolled in any courses.
                </p>
            }

        </div>

        <div class="card-footer d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                Edit
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back to Students
            </a>

        </div>

    </div>

</div>