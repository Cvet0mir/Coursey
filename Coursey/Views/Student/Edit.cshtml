@using Coursey.ViewModels.Student
@model StudentEditViewModel

@{
    ViewData["Title"] = "Edit Student";
}

<div class="container mt-4">

    <h2 class="mb-4">Edit Student</h2>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Edit" method="post">

                <input asp-for="Id" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" type="email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="BirthDate" class="form-label"></label>
                    <input asp-for="BirthDate" type="date" class="form-control" />
                    <span asp-validation-for="BirthDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FavouriteSubject" class="form-label"></label>
                    <input asp-for="FavouriteSubject" class="form-control" />
                    <span asp-validation-for="FavouriteSubject" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SelectedCourseIds" class="form-label">
                        Courses
                    </label>

                    <select asp-for="SelectedCourseIds"
                            class="form-select"
                            multiple
                            size="6">

                        @foreach (var course in Model.AvailableCourses)
                        {
                            <option value="@course.Id">
                                @course.Name (@course.Subject)
                            </option>
                        }

                    </select>

                    <small class="form-text text-muted">
                        Hold Ctrl (Windows) or Command (Mac) to select multiple courses.
                        Existing selections are automatically selected.
                    </small>

                    <span asp-validation-for="SelectedCourseIds"
                          class="text-danger">
                    </span>
                </div>

                <div class="d-flex gap-2 mt-4">

                    <button type="submit" class="btn btn-warning">
                        Save Changes
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}