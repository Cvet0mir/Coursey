@using Coursey.ViewModels.Course
@model List<CourseIndexViewModel>

@{
    ViewData["Title"] = "Courses";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Courses</h2>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Course
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Subject</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Difficulty</th>
                        <th>Teacher</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var course in Model)
                    {
                        <tr>
                            <td>@course.Name</td>
                            <td>@course.Subject</td>
                            <td>@course.StartDate.ToString("dd.MM.yyyy")</td>
                            <td>@course.EndDate.ToString("dd.MM.yyyy")</td>
                            <td>@(course.Difficulty ?? "Not specified")</td>
                            <td>@course.TeacherName</td>

                            <td class="text-center">
                                <div class="btn-group" role="group">

                                    <a asp-action="Details"
                                       asp-route-id="@course.Id"
                                       class="btn btn-sm btn-outline-info">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@course.Id"
                                       class="btn btn-sm btn-outline-warning">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@course.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No courses were found.
        </div>
    }

</div>
