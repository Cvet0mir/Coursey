@using Coursey.ViewModels.Course
@model List<CourseIndexViewModel>

@{
    ViewData["Title"] = "Courses";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Courses</h2>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Course
        </a>
    </div>

    <div class="row mb-4">

        <div class="col-md-3">
            <label for="search" class="form-label">Course Name</label>
            <input type="text"
                   id="search"
                   class="form-control"
                   placeholder="Search by course name..." />
        </div>

        <div class="col-md-3">
            <label for="subject" class="form-label">Subject</label>
            <input type="text"
                   id="subject"
                   class="form-control"
                   placeholder="Search by subject..." />
        </div>

        <div class="col-md-2">
            <label for="difficulty" class="form-label">Difficulty</label>
            <input type="text"
                   id="difficulty"
                   class="form-control"
                   placeholder="Search difficulty..." />
        </div>

        <div class="col-md-2">
            <label for="sortOrder" class="form-label">Sort By</label>
            <select id="sortOrder" class="form-select">
                <option value="name_asc">Name A-Z</option>
                <option value="name_desc">Name Z-A</option>
                <option value="start_date">Start Date</option>
                <option value="difficulty">Difficulty</option>
            </select>
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <button type="button"
                    id="clearFilters"
                    class="btn btn-secondary w-100">
                Clear Filters
            </button>
        </div>

    </div>

    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle">

            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Subject</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Difficulty</th>
                    <th>Teacher</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody id="coursesTable"
                   data-url="@Url.Action("GetFilteredCourses", "Course")"
                   data-details-url="@Url.Action("Details", "Course", new { id = "__id__" })"
                   data-edit-url="@Url.Action("Edit", "Course", new { id = "__id__" })"
                   data-delete-url="@Url.Action("Delete", "Course", new { id = "__id__" })">

                @if (Model.Any())
                {
                    @foreach (var course in Model)
                    {
                        <tr>
                            <td>@course.Name</td>
                            <td>@course.Subject</td>
                            <td>@course.StartDate.ToString("dd.MM.yyyy")</td>
                            <td>@course.EndDate.ToString("dd.MM.yyyy")</td>
                            <td>@(course.Difficulty ?? "Not specified")</td>
                            <td>@course.TeacherName</td>

                            <td class="text-center">
                                <div class="btn-group" role="group">

                                    <a asp-action="Details"
                                       asp-route-id="@course.Id"
                                       class="btn btn-sm btn-outline-info">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@course.Id"
                                       class="btn btn-sm btn-outline-warning">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@course.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center">
                            No courses were found.
                        </td>
                    </tr>
                }

            </tbody>

        </table>
    </div>

</div>

@section Scripts {
    <script src="~/js/courses.js" asp-append-version="true"></script>
}
