@using Coursey.ViewModels.Course
@model CourseEditViewModel

@{
    ViewData["Title"] = "Edit Course";
}

<div class="container mt-4">

    <h2 class="mb-4">Edit Course</h2>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Edit" method="post">

                <input asp-for="Id" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">
                        Course Name
                    </label>

                    <input asp-for="Name" class="form-control" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Subject" class="form-label">
                        Subject
                    </label>

                    <input asp-for="Subject" class="form-control" />

                    <span asp-validation-for="Subject"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="StartDate" class="form-label">
                        Start Date
                    </label>

                    <input asp-for="StartDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="StartDate"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="EndDate" class="form-label">
                        End Date
                    </label>

                    <input asp-for="EndDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="EndDate"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Difficulty" class="form-label">
                        Difficulty
                    </label>

                    <input asp-for="Difficulty"
                           class="form-control"
                           placeholder="e.g. Beginner, Intermediate, Advanced" />

                    <span asp-validation-for="Difficulty"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="TeacherId" class="form-label">
                        Teacher
                    </label>

                    <select asp-for="TeacherId" class="form-select">
                        <option value="">-- Select a Teacher --</option>

                        @foreach (var teacher in Model.Teachers)
                        {
                            <option value="@teacher.Id">
                                @teacher.FirstName @teacher.LastName
                            </option>
                        }
                    </select>

                    <span asp-validation-for="TeacherId"
                          class="text-danger">
                    </span>
                </div>

                <div class="d-flex gap-2 mt-4">

                    <button type="submit" class="btn btn-warning">
                        Save Changes
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
