@using Coursey.ViewModels.Teacher
@model List<TeacherIndexViewModel>

@{
    ViewData["Title"] = "Teachers";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Teachers</h2>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Teacher
        </a>
    </div>

    <form asp-action="Index" method="get" class="row g-3 mb-4">

        <div class="col-md-5">
            <input type="text"
                   name="search"
                   class="form-control"
                   placeholder="Search by name or subject..."
                   value="@Context.Request.Query["search"]" />
        </div>

        <div class="col-md-3">
            <input type="number"
                   name="age"
                   class="form-control"
                   placeholder="Filter by age"
                   value="@Context.Request.Query["age"]" />
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-primary w-100">
                Search
            </button>
        </div>

        <div class="col-md-2">
            <a asp-action="Index" class="btn btn-outline-secondary w-100">
                Clear
            </a>
        </div>

    </form>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>
                            <a asp-action="Index"
                               asp-route-search="@Context.Request.Query["search"]"
                               asp-route-age="@Context.Request.Query["age"]"
                               asp-route-sortOrder="firstName"
                               class="text-white text-decoration-none">
                                First Name
                            </a>
                        </th>

                        <th>
                            <a asp-action="Index"
                               asp-route-search="@Context.Request.Query["search"]"
                               asp-route-age="@Context.Request.Query["age"]"
                               asp-route-sortOrder="lastName"
                               class="text-white text-decoration-none">
                                Last Name
                            </a>
                        </th>

                        <th>Main Subject</th>

                        <th>Experience</th>

                        <th>
                            <a asp-action="Index"
                               asp-route-search="@Context.Request.Query["search"]"
                               asp-route-age="@Context.Request.Query["age"]"
                               asp-route-sortOrder="age asc"
                               class="text-white text-decoration-none">
                                Age ↑
                            </a>
                            |
                            <a asp-action="Index"
                               asp-route-search="@Context.Request.Query["search"]"
                               asp-route-age="@Context.Request.Query["age"]"
                               asp-route-sortOrder="age desc"
                               class="text-white text-decoration-none">
                                ↓
                            </a>
                        </th>

                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var teacher in Model)
                    {
                        <tr>
                            <td>@teacher.FirstName</td>
                            <td>@teacher.LastName</td>
                            <td>@teacher.MainSubject</td>
                            <td>@teacher.YearsExperience years</td>
                            <td>@teacher.Age</td>

                            <td class="text-center">
                                <div class="btn-group" role="group">

                                    <a asp-action="Details"
                                       asp-route-id="@teacher.Id"
                                       class="btn btn-sm btn-outline-info">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@teacher.Id"
                                       class="btn btn-sm btn-outline-warning">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@teacher.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No teachers were found.
        </div>
    }
</div>